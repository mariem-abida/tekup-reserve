@model IEnumerable<TEKUP_RESERVE.Models.Booking>

@{
    var isAdmin = User.IsInRole("Admin");
    ViewData["Title"] = isAdmin ? "Toutes les réservations" : "Mes réservations";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<p>
    <a class="btn btn-primary" asp-action="Create">Nouvelle réservation</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Salle</th>
            <th>Début</th>
            <th>Fin</th>
            <th>Motif</th>

            @if (isAdmin)
            {
                <th>Utilisateur</th>
            }

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Room?.Name</td>
                <td>@item.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.EndTime.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Purpose</td>

                @if (isAdmin)
                {
                    <td>@item.UserId</td>
                }

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Détails</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>
