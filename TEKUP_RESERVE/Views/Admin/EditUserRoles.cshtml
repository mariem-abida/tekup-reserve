@model TEKUP_RESERVE.Models.EditUserRolesViewModel

@{
    ViewData["Title"] = "Modifier les rôles";
}

<h1>Modifier les rôles</h1>

<div class="mb-3">
    <strong>Utilisateur :</strong> @Model.FullName (@Model.Email)
</div>

<form asp-action="EditUserRoles" method="post">
    <input type="hidden" asp-for="UserId" />

    <div class="mb-3">
        <h5>Rôles disponibles</h5>

        @for (int i = 0; i < Model.Roles.Count; i++)
        {
            <div class="form-check">
                <input class="form-check-input"
                       asp-for="Roles[@i].Selected" />
                <label class="form-check-label">
                    @Model.Roles[i].RoleName
                </label>
                <input type="hidden" asp-for="Roles[@i].RoleName" />
            </div>
        }
    </div>

    <button type="submit" class="btn btn-success">Enregistrer</button>
    <a asp-action="Users" class="btn btn-secondary">Annuler</a>
</form>
