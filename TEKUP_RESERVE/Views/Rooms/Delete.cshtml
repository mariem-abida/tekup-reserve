@model TEKUP_RESERVE.Models.Room

@{
    ViewData["Title"] = "Supprimer la salle";
}

<h1>Supprimer la salle</h1>

<h3>Es-tu sûre de vouloir supprimer cette salle ?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Nom</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Type</dt>
        <dd class="col-sm-10">@Model.Type</dd>

        <dt class="col-sm-2">Capacité</dt>
        <dd class="col-sm-10">@Model.Capacity</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Supprimer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>
