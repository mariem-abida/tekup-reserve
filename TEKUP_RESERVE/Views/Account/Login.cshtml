@model TEKUP_RESERVE.Models.LoginViewModel
@{
    ViewData["Title"] = "Connexion";
}

<section class="auth-page d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="auth-card">

                    <!-- Logo + titre -->
                    <div class="text-center mb-4">
                        <div class="auth-logo mb-2">
                            <img src="~/images/tekup-logo.png" alt="TEK-UP University" />
                        </div>
                        <h1 class="auth-title">Connexion</h1>
                        <p class="auth-subtitle">
                            Connectez-vous à votre espace <strong>TEKUP RESERVE</strong> pour gérer vos réservations.
                        </p>
                    </div>

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control auth-input" autocomplete="username" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password"
                                   class="form-control auth-input"
                                   type="password"
                                   autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label"></label>
                            </div>
                            <!-- Optionnel : lien mot de passe oublié -->
                            @* <a asp-action="ForgotPassword" class="auth-link-small">Mot de passe oublié ?</a> *@
                        </div>

                        <button type="submit" class="btn btn-auth w-100 mb-3">
                            Se connecter
                        </button>

                        <div class="text-center">
                            <span class="auth-subtext">Nouveau sur TEKUP RESERVE ?</span>
                            <a asp-action="Register" class="auth-link">Créer un compte</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>
