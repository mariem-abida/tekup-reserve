@{
    ViewData["Title"] = "Ressources & aide";

    var userName = User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(userName))
    {
        userName = "Enseignant";
    }
    var initial = userName[0].ToString().ToUpper();
}

<section class="student-layout">
    <div class="container-fluid py-4">
        <div class="row g-4">

            <!-- SIDEBAR -->
            <div class="col-lg-3">
                <div class="student-sidebar">
                    <div class="student-sidebar-header mb-3">
                        <div class="student-avatar mb-2">@initial</div>
                        <div class="small text-muted">Connecté(e)</div>
                        <div class="fw-semibold">@userName</div>
                        <span class="badge bg-info text-dark mt-2">Enseignant</span>
                    </div>

                    <nav class="student-nav flex-column nav-pills">
                        <a asp-controller="Teacher" asp-action="Dashboard" class="nav-link">
                            <span class="student-nav-icon">🎓</span> Tableau de bord
                        </a>
                        <a asp-controller="Teacher" asp-action="Calendar" class="nav-link">
                            <span class="student-nav-icon">📅</span> Planning des cours
                        </a>
                        <a asp-controller="Teacher" asp-action="Reservations" class="nav-link">
                            <span class="student-nav-icon">🏫</span> Mes réservations
                        </a>
                        <a asp-controller="Teacher" asp-action="Notifications" class="nav-link">
                            <span class="student-nav-icon">🔔</span> Notifications
                        </a>
                        <a asp-controller="Teacher" asp-action="Help" class="nav-link active">
                            <span class="student-nav-icon">❓</span> Ressources & aide
                        </a>
                    </nav>
                </div>
            </div>

            <!-- CONTENU -->
            <div class="col-lg-9">
                <div class="student-main card border-0 shadow-sm">
                    <div class="card-body">
                        <h1 class="h4 mb-3">Ressources & aide</h1>
                        <p class="text-muted mb-3">
                            Informations pratiques pour utiliser TEKUP RESERVE en tant qu’enseignant.
                        </p>

                        <div class="dashboard-card mb-3">
                            <h5 class="dashboard-card-title">Bonnes pratiques de réservation</h5>
                            <ul class="small mb-0">
                                <li>Réserver vos salles au moins une semaine à l’avance.</li>
                                <li>Annuler les créneaux non utilisés pour libérer la salle.</li>
                                <li>Vérifier que le matériel nécessaire est disponible (vidéoprojecteur, PC…).</li>
                            </ul>
                        </div>

                        <div class="dashboard-card mb-3">
                            <h5 class="dashboard-card-title">Contacts utiles</h5>
                            <ul class="small mb-2">
                                <li><strong>Responsable administratif :</strong> admin-salles@tekup.tn</li>
                                <li><strong>Support technique :</strong> support@tekup.tn</li>
                            </ul>
                            <a href="mailto:admin-salles@tekup.tn" class="btn btn-sm btn-outline-primary me-2">
                                Contacter l’administration
                            </a>
                            <a href="mailto:support@tekup.tn" class="btn btn-sm btn-outline-secondary">
                                Contacter le support
                            </a>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
