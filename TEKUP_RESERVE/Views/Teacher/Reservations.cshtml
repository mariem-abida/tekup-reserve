@{
    ViewData["Title"] = "Mes réservations de salles";

    var userName = User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(userName))
    {
        userName = "Enseignant";
    }
    var initial = userName[0].ToString().ToUpper();
}

<section class="student-layout">
    <div class="container-fluid py-4">
        <div class="row g-4">

            <!-- SIDEBAR -->
            <div class="col-lg-3">
                <div class="student-sidebar">
                    <div class="student-sidebar-header mb-3">
                        <div class="student-avatar mb-2">@initial</div>
                        <div class="small text-muted">Connecté(e)</div>
                        <div class="fw-semibold">@userName</div>
                        <span class="badge bg-info text-dark mt-2">Enseignant</span>
                    </div>

                    <nav class="student-nav flex-column nav-pills">
                        <a asp-controller="Teacher" asp-action="Dashboard" class="nav-link">
                            <span class="student-nav-icon">🎓</span> Tableau de bord
                        </a>
                        <a asp-controller="Teacher" asp-action="Calendar" class="nav-link">
                            <span class="student-nav-icon">📅</span> Planning des cours
                        </a>
                        <a asp-controller="Teacher" asp-action="Reservations" class="nav-link active">
                            <span class="student-nav-icon">🏫</span> Mes réservations
                        </a>
                        <a asp-controller="Teacher" asp-action="Notifications" class="nav-link">
                            <span class="student-nav-icon">🔔</span> Notifications
                        </a>
                        <a asp-controller="Teacher" asp-action="Help" class="nav-link">
                            <span class="student-nav-icon">❓</span> Ressources & aide
                        </a>
                    </nav>
                </div>
            </div>

            <!-- CONTENU -->
            <div class="col-lg-9">
                <div class="student-main card border-0 shadow-sm">
                    <div class="card-body">
                        <h1 class="h4 mb-3">Mes réservations de salles</h1>
                        <p class="text-muted mb-3">
                            Liste de vos réservations de salles (cours, examens, soutenances). Plus tard,
                            tu pourras lier cette vue au contrôleur Bookings avec un vrai modèle.
                        </p>

                        <a asp-controller="Bookings" asp-action="Create"
                           class="btn btn-primary btn-sm mb-3">
                            + Planifier une nouvelle réservation
                        </a>

                        <table class="table table-hover align-middle small">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Heure</th>
                                    <th>Salle</th>
                                    <th>Matière / Motif</th>
                                    <th>Groupe</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>24/03/2025</td>
                                    <td>08:00–10:00</td>
                                    <td>B201</td>
                                    <td>C# – TP</td>
                                    <td>L2 Dev</td>
                                    <td><span class="badge bg-success">Confirmé</span></td>
                                </tr>
                                <tr>
                                    <td>25/03/2025</td>
                                    <td>10:00–12:00</td>
                                    <td>A105</td>
                                    <td>Bases de données – Cours</td>
                                    <td>L3 SI</td>
                                    <td><span class="badge bg-warning text-dark">En attente</span></td>
                                </tr>
                                <tr>
                                    <td>27/03/2025</td>
                                    <td>14:00–16:00</td>
                                    <td>Lab 2</td>
                                    <td>.NET – PFE</td>
                                    <td>M2</td>
                                    <td><span class="badge bg-success">Confirmé</span></td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
